{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_EXPO_OWNER": "wodanas-team",
        "EXPO_PUBLIC_APP_SLUG": "wodana"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": { "EXPO_PUBLIC_APP_ENV": "development" }
    },
    "uat": {
      "extends": "base",
      "distribution": "internal",
      "channel": "uat",
      "environment": "preview",
      "autoIncrement": true,
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "uat",
        "EXPO_PUBLIC_AUTH_API_URL": "https://plm.wodana.ai/api/v1"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_AUTH_API_URL": "https://plm.wodana.ai/api/v1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "MSZ9TCZKAB"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
