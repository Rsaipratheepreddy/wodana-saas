NODE_ENV=development
ENVIRONMENT=development
POSTGRES_USER=wodana_owner
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=wodana
POSTGRES_APP_USER=wodana_app
POSTGRES_APP_PASSWORD=change-app-password-locally
MIGRATION_DATABASE_URL=postgresql://wodana_owner:change-me-locally@localhost:5432/wodana
DATABASE_URL=postgresql://wodana_app:change-app-password-locally@localhost:5432/wodana
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379/0

# S3-compatible object storage. Leave the bucket empty for local filesystem storage.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=ap-south-1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_PUBLIC_ENDPOINT=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
BRAND_ASSET_STORAGE_DIR=.data/workspace-assets

WEB_PORT=3000
BUSINESS_CORE_PORT=8000
INTELLIGENCE_API_PORT=8001
POSTGRES_PORT=5432
REDIS_PORT=6379
NEXT_PUBLIC_BUSINESS_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_INTELLIGENCE_API_URL=http://localhost:8001/api/v1
WEB_ORIGIN=http://localhost:3000

BUSINESS_CORE_URL=http://localhost:8000/api/v1
BUSINESS_CORE_INTERNAL_TOKEN=replace-with-a-long-random-value
INTEGRATIONS_ENCRYPTION_KEY=replace-with-a-managed-secret
DEPENDENCY_CHECKS_ENABLED=false
LOG_LEVEL=INFO
# How the worker delivers email, WhatsApp and push: test (marks them delivered without sending;
# refused in production), live (through each tenant's connected Gmail/WhatsApp and Expo; locally
# `npm run dev:worker` requires DELIVERY_ALLOWLIST for it), unconfigured (every delivery fails).
NOTIFICATION_ADAPTER_MODE=test
# Local and UAT safety guard: when set, email, WhatsApp and push go only to these recipients
# (exact emails, *@domain, E.164 numbers, comma separated); everyone else is suppressed as
# not_allowlisted. Business Core and the worker both read it. Refused when ENVIRONMENT=production.
DELIVERY_ALLOWLIST=
WORKER_CONSUMER_GROUP=wodana-intelligence
WORKER_CONSUMER_NAME=worker-1

# Authentication: signed local sessions for local development, OIDC outside local development.
AUTH_MODE=local
LOCAL_AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
LOCAL_AUTH_ISSUER=wodana-local
LOCAL_AUTH_AUDIENCE=wodana-web
# Generate with: openssl rand -hex 32. Keep the production value in the secret manager.
MFA_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY_VERSION=1
MFA_TOTP_ISSUER=Wodana
MFA_STEP_UP_MINUTES=10
# Optional test-account UUIDs. Removes only the concurrent-device cap; sign-in and logout still apply.
AUTH_DEVICE_LIMIT_EXEMPT_USER_IDS=
# Devices one person may stay signed in on (default 2); "unlimited" for a trial where testers share logins.
AUTH_MAX_ACTIVE_DEVICES=
# Minutes a sign-in stays valid before a silent refresh (5–1440, default 15).
AUTH_ACCESS_TOKEN_MINUTES=
EXPOSE_DEMO_AUTH_TOKENS=true
LOGIN_TENANT_SLUG=iglo-architects
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=

# Wodana's app credentials are set in Wodana Control → Platform connections (applied within a minute).
# These are only the fallback for a field left empty there; keep any in a secret manager or untracked .env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/v1/integrations/google/oauth/callback
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
GOOGLE_REQUEST_TIMEOUT_SECONDS=15
# Linking a Google Sheet to an Inventory or Catalog import (web, read at request time): the Google Picker's browser
# API key (restricted to the Picker API and Wodana's domains) and the Cloud project number of the same OAuth app.
# Left empty, only file uploads are offered.
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_REDIRECT_URI=http://localhost:8001/api/v1/integrations/providers/quickbooks/oauth/callback
QUICKBOOKS_WEBHOOK_VERIFIER=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:8001/api/v1/integrations/providers/zoho_books/oauth/callback
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_CONFIG_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Tokens come from each tenant's Meta Embedded Signup, never one global sender token.

# Approved WhatsApp authentication template used by the client portal.
PORTAL_OTP_TEMPLATE=
PORTAL_OTP_LANGUAGE=en_US
PORTAL_OTP_SECRET=replace-with-at-least-32-random-characters

# Transactional invitation email. Use api.eu.mailgun.net for an EU Mailgun domain.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=
MAILGUN_BASE_URL=https://api.mailgun.net
# Email into the team inbox (PLM-025): the domain whose MX points at Mailgun (e.g. in.wodana.ai), and Mailgun's
# HTTP webhook signing key, which verifies every received email Mailgun posts to /api/v1/inbound/email/mailgun.
INBOUND_EMAIL_DOMAIN=
MAILGUN_WEBHOOK_SIGNING_KEY=

# Local/demo only. Use 123456 for explicitly granted test contacts. Never enable in production.
PORTAL_DEMO_OTP=false

# AI, read only by Business Core's AI gateway: every AI feature, the web assistants included, calls the
# model through it. Each workspace still turns AI on in Settings.
# AI_PROVIDER=bedrock uses Amazon Bedrock with the host's AWS credentials (no key); unset keeps Gemini when
# GEMINI_API_KEY is set. AI_MODEL defaults to apac.amazon.nova-lite-v1:0 on Bedrock.
AI_PROVIDER=
AI_MODEL=
BEDROCK_REGION=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# AI credits (1 credit = US$0.001 of model use): the welcome grant on first use, and the daily safety caps
# (UTC days) per workspace and across all workspaces.
AI_WELCOME_CREDITS=1000
AI_WORKSPACE_DAILY_CREDIT_LIMIT=1000
AI_PLATFORM_DAILY_CREDIT_LIMIT=5000
# AI apps (MCP at /api/v1/mcp): tool calls per connected app per minute, and app registrations per address
# per hour. Defaults 60 and 120.
MCP_CALLS_PER_MINUTE=
MCP_REGISTRATIONS_PER_HOUR=
