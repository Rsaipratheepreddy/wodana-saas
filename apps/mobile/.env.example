# Native API. iOS Simulator reaches this Mac at 127.0.0.1;
# Android Emulator uses 10.0.2.2. A physical device needs a reachable HTTPS API.
EXPO_PUBLIC_AUTH_API_URL=http://127.0.0.1:8000/api/v1
EXPO_PUBLIC_AUTH_TENANT_SLUG=iglo-architects
# Server-only upstream for the browser preview's HttpOnly-cookie auth proxy.
MOBILE_AUTH_PROXY_TARGET=http://127.0.0.1:8000/api/v1
