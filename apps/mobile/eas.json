{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "EXPO_PUBLIC_APP_ENV": "development" }
    },
    "uat": {
      "distribution": "internal",
      "channel": "uat",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_APP_ENV": "uat" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_APP_ENV": "production" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "MSZ9TCZKAB"
      }
    }
  }
}
