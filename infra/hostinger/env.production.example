# Copy to ../../.env.production. Never commit the completed file.
NODE_ENV=production
BASE_DOMAIN=wodana.ai
CERT_NAME=wodana.ai
CERTBOT_EMAIL=CHANGE_ME
CERTBOT_CONF_DIR=/opt/wodana/certbot/conf
CERTBOT_WWW_DIR=/opt/wodana/certbot/www
WODANA_RELEASE_ID=CHANGE_ME_RELEASE_ID

POSTGRES_USER=wodana_owner
POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_RANDOM_HEX
POSTGRES_DB=wodana
POSTGRES_APP_USER=wodana_app
POSTGRES_APP_PASSWORD=CHANGE_ME_URL_SAFE_RANDOM_HEX

WEB_ORIGIN=https://wodana.ai,https://www.wodana.ai,https://admin.wodana.ai,https://client.wodana.ai
BUSINESS_CORE_INTERNAL_TOKEN=CHANGE_ME_MINIMUM_32_RANDOM_CHARACTERS
INTEGRATIONS_ENCRYPTION_KEY=CHANGE_ME_STABLE_MINIMUM_32_RANDOM_CHARACTERS
PORTAL_OTP_SECRET=CHANGE_ME_STABLE_MINIMUM_32_RANDOM_CHARACTERS
LOG_LEVEL=INFO

# Password mode uses existing credential records; it never seeds or resets users.
AUTH_MODE=password
LOCAL_AUTH_JWT_SECRET=CHANGE_ME_STABLE_MINIMUM_32_RANDOM_CHARACTERS
LOCAL_AUTH_ISSUER=https://admin.wodana.ai
LOCAL_AUTH_AUDIENCE=wodana-web
# Optional alternative for an installed OIDC identity provider.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
LOGIN_TENANT_SLUG=iglo-architects

# Leave OBJECT_STORAGE_BUCKET empty to use the VPS data volume.
# Disk encryption must be configured on the host; Docker volumes are not encrypted by default.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=ap-south-1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_PUBLIC_ENDPOINT=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM="Wodana <notifications@CHANGE_ME>"
MAILGUN_BASE_URL=https://api.mailgun.net

GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://api.wodana.ai/api/v1/integrations/google/oauth/callback
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
GOOGLE_REQUEST_TIMEOUT_SECONDS=15

QUICKBOOKS_CLIENT_ID=CHANGE_ME
QUICKBOOKS_CLIENT_SECRET=CHANGE_ME
QUICKBOOKS_ENVIRONMENT=production
QUICKBOOKS_REDIRECT_URI=https://api.wodana.ai/api/v1/integrations/providers/quickbooks/oauth/callback
QUICKBOOKS_WEBHOOK_VERIFIER=CHANGE_ME

ZOHO_CLIENT_ID=CHANGE_ME
ZOHO_CLIENT_SECRET=CHANGE_ME
ZOHO_REDIRECT_URI=https://api.wodana.ai/api/v1/integrations/providers/zoho_books/oauth/callback

WHATSAPP_APP_ID=CHANGE_ME
WHATSAPP_APP_SECRET=CHANGE_ME
WHATSAPP_CONFIG_ID=CHANGE_ME
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_RANDOM_VALUE
PORTAL_OTP_TEMPLATE=
PORTAL_OTP_LANGUAGE=en_US

WORKER_CONSUMER_GROUP=wodana-intelligence
WORKER_CONSUMER_NAME=worker-1
