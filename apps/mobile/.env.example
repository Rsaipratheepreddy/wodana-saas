# Native API. iOS Simulator reaches this Mac at 127.0.0.1; Android Emulator uses 10.0.2.2.
# A physical device needs a reachable HTTPS API.
EXPO_PUBLIC_AUTH_API_URL=http://127.0.0.1:8000/api/v1
# Sign-in is email first: the account decides the workspace. Set both values below only for a
# build locked to one workspace.
EXPO_PUBLIC_AUTH_TENANT_SLUG=
EXPO_PUBLIC_MOBILE_SINGLE_TENANT=false
# development allows loopback. uat/production require HTTPS.
EXPO_PUBLIC_APP_ENV=development
# White-label build (optional): app name, icon, splash and identifiers. Defaults are Wodana's.
EXPO_PUBLIC_APP_NAME=
EXPO_PUBLIC_APP_ICON=
EXPO_PUBLIC_SPLASH_IMAGE=
EXPO_PUBLIC_SPLASH_BACKGROUND=
EXPO_PUBLIC_BUNDLE_ID=
EXPO_PUBLIC_APP_SCHEME=
# Expo account and project (the EAS project ID is on expo.dev → the project's Overview).
EXPO_PUBLIC_EXPO_OWNER=wodanas-team
EXPO_PUBLIC_APP_SLUG=wodana
# EAS project UUID used to request an Expo push token in a native build.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Server-only upstream for the browser preview's HttpOnly-cookie auth proxy.
MOBILE_AUTH_PROXY_TARGET=http://127.0.0.1:8000/api/v1
