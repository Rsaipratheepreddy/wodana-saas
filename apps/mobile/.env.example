# Native API. iOS Simulator reaches this Mac at 127.0.0.1;
# Android Emulator uses 10.0.2.2. A physical device needs a reachable HTTPS API.
EXPO_PUBLIC_AUTH_API_URL=http://127.0.0.1:8000/api/v1
EXPO_PUBLIC_AUTH_TENANT_SLUG=iglo-architects
# development allows loopback. uat/production require HTTPS; production also requires a locked tenant.
EXPO_PUBLIC_APP_ENV=development
# Set to the tenant web origin when its logo is stored in Wodana (for example https://tenant.wodana.ai).
# The app uses this only to resolve relative logo URLs returned by /me.
EXPO_PUBLIC_WORKSPACE_ORIGIN=http://127.0.0.1:3100
# EAS project UUID used to request an Expo push token in a native build.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Server-only upstream for the browser preview's HttpOnly-cookie auth proxy.
MOBILE_AUTH_PROXY_TARGET=http://127.0.0.1:8000/api/v1
