{
  "name": "@wodana/business-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "start": "node dist/main.js",
    "start:dev": "node --watch -r ts-node/register src/main.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke-workspace.mjs",
    "test:smoke:auth": "node scripts/smoke-auth-onboarding.mjs",
    "test:smoke:operator": "node scripts/smoke-platform-operator.mjs",
    "test:smoke:local-auth": "node scripts/smoke-local-auth.mjs",
    "test:smoke:seats": "node scripts/smoke-seat-capacity.mjs",
    "test:smoke:app-effects": "node scripts/smoke-tenant-app-effects.mjs",
    "test:smoke:tenant-isolation": "node scripts/verify-tenant-isolation.mjs",
    "test:smoke:portfolio-calendar": "node scripts/smoke-portfolio-calendar.mjs",
    "test:smoke:customer-accounts": "node scripts/smoke-customer-accounts.mjs",
    "test:smoke:mfa": "node scripts/smoke-mfa.mjs",
    "test:smoke:vendors": "node scripts/smoke-vendor-directory.mjs",
    "test:smoke:supplier-offers": "node scripts/smoke-supplier-offers.mjs",
    "test:smoke:google": "node scripts/smoke-google-integration.mjs",
    "test:smoke:crm": "node scripts/smoke-crm.mjs",
    "test:smoke:funnel": "node scripts/smoke-funnel.mjs",
    "test:smoke:palm-clone": "node scripts/smoke-funnel.mjs && tsx scripts/smoke-palm-clone-migration.ts",
    "test:fixture:palm": "node scripts/palm-living-fixture.test.mjs",
    "db:backfill:one-tree": "tsx scripts/backfill-one-tree.ts",
    "test:smoke:one-tree": "tsx scripts/smoke-one-tree-identity.ts",
    "seed:crm:iglo": "node scripts/seed-iglo-crm.mjs",
    "seed:palm:local": "node scripts/seed-palm-local.mjs",
    "seed:palm:review-demo": "node scripts/seed-palm-review-demo.mjs",
    "seed:palm:review-hrms": "node scripts/seed-palm-review-hrms.mjs",
    "seed:palm:review-catalog": "../../node_modules/.bin/tsx scripts/seed-palm-review-catalog.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "jwks-rsa": "4.1.0",
    "pg": "8.23.0",
    "redis": "^5.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^22.15.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.10",
    "supertest": "7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
